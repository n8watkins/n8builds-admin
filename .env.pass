# pass-env reference file: variable name = entry name in pass. Names only, never values.
# Safe to commit. Check with: pass-env check   Run with: pass-env run -- npm run dev
# Every secret this dashboard reads is listed in docs/SETUP.md; add each here as it moves into pass.

# Cloudflare API token, Account Analytics read-only: the Cloudflare usage page
# (the owner stores it with: pass-env set n8builds-admin/CF_ANALYTICS_TOKEN)
CF_ANALYTICS_TOKEN=n8builds-admin/CF_ANALYTICS_TOKEN
GITHUB_OAUTH_CLIENT_ID=n8builds-admin/GITHUB_OAUTH_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=n8builds-admin/GITHUB_OAUTH_CLIENT_SECRET
GITHUB_TOKEN=n8builds-admin/GITHUB_TOKEN
GITHUB_ORG_TOKEN=n8builds-admin/GITHUB_ORG_TOKEN
SENTRY_AUTH_TOKEN=n8builds-admin/SENTRY_AUTH_TOKEN
GOOGLE_SA_PRIVATE_KEY=n8builds-admin/GOOGLE_SA_PRIVATE_KEY
GA4_PROPERTY_ID=n8builds-admin/GA4_PROPERTY_ID
CLOUDFLARE_DEPLOYS_TOKEN=n8builds-admin/CF_ANALYTICS_TOKEN
