{
  "name": "n8builds-admin",
  "version": "0.1.0",
  "description": "Owner-only dashboard for n8builds.dev (admin.n8builds.dev).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nathan Watkins",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev -p 3831",
    "build": "next build",
    "postbuild": "node scripts/check-no-dev-bypass.mjs",
    "build:e2e": "ADMIN_E2E_BUILD=1 next build",
    "postbuild:e2e": "ADMIN_E2E_BUILD=1 node scripts/check-no-dev-bypass.mjs",
    "build:worker": "opennextjs-cloudflare build && node scripts/check-no-dev-bypass.mjs --worker",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareEnv --strict-vars=false cloudflare-env.d.ts",
    "check:cf-types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareEnv --strict-vars=false --check cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply n8builds-admin --remote",
    "db:local": "node scripts/db-local.mjs",
    "start": "next start -p 3831",
    "start:e2e": "ADMIN_E2E_BUILD=1 ADMIN_TEST_AUTH=1 next start -p 3831",
    "lint": "eslint . --max-warnings 0",
    "type-check": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:e2e && playwright test",
    "test:e2e:only": "playwright test",
    "setup:docs": "node scripts/gen-setup-docs.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run type-check && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@sentry/nextjs": "11.10.0",
    "jose": "^6.2.14",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "release-kit": "github:n8watkins/release-kit#v2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
