{
  "name": "n8builds-admin",
  "version": "0.1.0",
  "description": "Private owner dashboard for n8builds.dev (admin.n8builds.dev).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Nathan Watkins",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev -p 3831",
    "build": "next build",
    "postbuild": "node scripts/check-no-dev-bypass.mjs",
    "build:e2e": "ADMIN_E2E_BUILD=1 next build",
    "postbuild:e2e": "ADMIN_E2E_BUILD=1 node scripts/check-no-dev-bypass.mjs",
    "start": "next start -p 3831",
    "start:e2e": "ADMIN_E2E_BUILD=1 ADMIN_TEST_AUTH=1 next start -p 3831",
    "lint": "eslint . --max-warnings 0",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:e2e && playwright test",
    "test:e2e:only": "playwright test",
    "setup:docs": "node scripts/gen-setup-docs.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run type-check && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.76.2",
    "@upstash/redis": "^1.40.0",
    "jose": "^6.2.13",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.31",
    "release-kit": "github:n8watkins/release-kit#v2.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
