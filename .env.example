# Copy to .env.local and fill in. Never commit real values.
# docs/SETUP.md says where each one comes from.

# Sign-in (GitHub OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 32+ random characters: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Local preview only: skips sign-in when NODE_ENV=development. Ignored by production builds.
ADMIN_DEV_BYPASS=

# GitHub data (fine-grained token, read-only)
GITHUB_TOKEN=

# Sentry (read-only org token)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# Comma-separated project slugs
SENTRY_PROJECTS=

# Google Analytics 4 Data API (service account)
GA4_PROPERTY_ID=
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# The D1 databases are bindings, not variables (wrangler.jsonc, docs/DATABASE.md):
# `npm run db:local` creates their tables in wrangler's local simulation.

# The Worker's Cron Trigger sends this as a Bearer token to /api/cron/snapshot
CRON_SECRET=

# Cloudflare API token, Workers Scripts read-only: the Releases page's deploys
CLOUDFLARE_DEPLOYS_TOKEN=

# Cloudflare API token, Account Analytics read-only: the Cloudflare usage page
# (pass-env entry n8builds-admin/CF_ANALYTICS_TOKEN, see .env.pass)
CF_ANALYTICS_TOKEN=
